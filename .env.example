NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=
SANITY_API_TOKEN=
SANITY_REVALIDATE_SECRET=
NEXT_PUBLIC_GA_ID=G-1072B0BJEX

# --- Desk: WhatsApp concierge + owner dashboard ---

# Supabase. The service-role key is server-only and must never appear in a
# NEXT_PUBLIC_ var or reach the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta). Build against a test number; the public number
# migrates at cutover. While the Meta app does not exist yet, leave the token
# and phone id blank: every send is then simulated and logged instead of sent.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# Required from day one, even before Meta exists: the webhook rejects every
# unsigned request, and /desk/simulator signs with this. Any random string now,
# replaced by Meta's real App Secret at cutover.
WHATSAPP_APP_SECRET=

# Set to 1 to expose /desk/simulator on a production build. Always on in dev.
ENABLE_SIMULATOR=

# LLM. Groq only, one model for routing, extraction and replies.
# llama-3.3-70b-versatile was deprecated in June 2026; see
# https://console.groq.com/docs/models for what is current.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# The concierge's own WhatsApp number, E.164 without the '+'.
CONCIERGE_WA_ID=
CRON_SECRET=
